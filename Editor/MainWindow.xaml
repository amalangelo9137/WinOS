        Foreground="#F4F8FC"
        Icon="/WinOS-Logo.png"
        WindowStartupLocation="CenterScreen" WindowStyle="ThreeDBorderWindow">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed" />
    </Window.CommandBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#3D5AFE"/>
        <SolidColorBrush x:Key="CardBrush" Color="#161C26"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0E1825"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#24374A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9DB4C8"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF5252"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A2533"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A3C4E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="GotKeyboardFocus" Handler="InspectorTextBox_GotKeyboardFocus"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="InspectorTextBox_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseWheel" Handler="InspectorTextBox_PreviewMouseWheel"/>
        </Style>

        <Style TargetType="TextBlock">
            <EventSetter Event="PreviewMouseWheel" Handler="InspectorLabel_PreviewMouseWheel"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="InspectorLabel_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="MouseMove" Handler="InspectorLabel_MouseMove"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="InspectorLabel_PreviewMouseLeftButtonUp"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0E1825"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#24374A"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161C26"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3D5AFE"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="AccentBrush1" Color="#3D5AFE"/>
        <SolidColorBrush x:Key="BorderBrush1" Color="#24374A"/>
        <Style x:Key="ButtonStyle1" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1A2533"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6,0,0,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#2A3C4E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource AccentBrush1}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource AccentBrush1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#FF7EB4EA"/>
        <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FF569DE5"/>
        <ControlTemplate x:Key="TextBoxTemplate1" TargetType="{x:Type TextBoxBase}">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" CornerRadius="0,6,6,0">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.MouseOver.Border}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="true">
                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Focus.Border}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="/WinOS-Editor-BG.png" Stretch="UniformToFill"/>
    </Window.Background>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="15,10" Margin="0,0,0,15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Image Source="/WinOS-Logo.png" Width="28" Height="28" Margin="0,0,12,0"/>
                    <TextBlock Text="WinOS GUI App Editor" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Center" Foreground="#FF00F8C8"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Menu Background="Transparent" Margin="0,0,10,0">
                        <MenuItem Header="➕ Add Component  " Foreground="White" FontSize="14" FontWeight="SemiBold" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <MenuItem.Background>
                                <SolidColorBrush Color="#1A2533"/>
                            </MenuItem.Background>
                            <MenuItem Header="Panel" Click="AddPanel_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                            <MenuItem Header="Canvas" Click="AddCanvas_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                            <MenuItem Header="Canvas Group" Click="AddCanvasGroup_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                            <MenuItem Header="Grid Layout Group" Click="AddGridLayoutGroup_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                            <MenuItem Header="Label" Click="AddLabel_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                            <MenuItem Header="Button" Click="AddButton_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                            <MenuItem Header="Slider" Click="AddSlider_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                            <MenuItem Header="Text Field" Click="AddTextField_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                            <MenuItem Header="Toggle" Click="AddToggle_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                            <MenuItem Header="Dropdown" Click="AddDropdown_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                            <MenuItem Header="Image" Click="AddImage_Click" Background="{StaticResource CardBrush}" Foreground="White"/>
                        </MenuItem>
                    </Menu>

                    <Separator Width="1" Background="{StaticResource BorderBrush}" Margin="10,5,20,5"/>
                    <Button Content="   🗑 Delete Selected    " Click="DeleteElement_Click" Foreground="{StaticResource DangerBrush}" Background="Transparent" BorderBrush="#33FF5252"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="  📂 Import Package  " Click="Open_Click" Margin="0,0,10,0"/>
                    <Button Style="{DynamicResource ButtonStyle1}" Content="  🚀 Export Package  " Click="Export_Click" Background="#FF008840" FontWeight="Bold"/>
                    <TextBox x:Name="textBox" Template="{DynamicResource TextBoxTemplate1}" TextWrapping="Wrap" Width="250" Padding="8,6,8,6" Text="{Binding customPath, BindsDirectlyToSource=True, ElementName=textBox, IsAsync=True, Mode=TwoWay, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12,12,12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="DOCUMENT SETTINGS" Foreground="#FF00CE93" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" TextAlignment="Center"/>

                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="Package Name" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Document.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="Alias" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Document.PackageAlias, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="Sample Display W"/>
                                <TextBox Text="{Binding Document.SampleDisplayWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="Sample Display H"/>
                                <TextBox Text="{Binding Document.SampleDisplayHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="Canvas Width" ToolTip="Supports values like 960 or 50% of the sample display width."/>
                                <TextBox Text="{Binding Document.CanvasWidthInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="Canvas Height" ToolTip="Supports values like 540 or 50% of the sample display height."/>
                                <TextBox Text="{Binding Document.CanvasHeightInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Separator Background="{StaticResource BorderBrush}" Margin="0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="ELEMENT HIERARCHY" Foreground="#FF00CE93" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" TextAlignment="Center"/>
                        <ListBox ItemsSource="{Binding Document.Elements}" 
                                 SelectedItem="{Binding SelectedElement, Mode=TwoWay}" 
                                 DisplayMemberPath="DisplayName" 
                                 MinHeight="200" Height="517" 
                                 />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderThickness="0,1,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                        <Border Background="#081019" Padding="20" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" Opacity="0.5" ShadowDepth="5"/>
                            </Border.Effect>
                            <Canvas x:Name="PreviewCanvas" 
                                    Width="{Binding Document.CanvasWidth}" 
                                    Height="{Binding Document.CanvasHeight}" 
                                    Background="#0F1720" 
                                    ClipToBounds="True"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12,12,12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20,20,20,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">

                        <TextBlock Text="INSPECTOR" FontSize="16" Foreground="#FF00AA6A" Margin="0,0,0,15" FontWeight="Bold" TextAlignment="Center"/>

                        <StackPanel IsEnabled="{Binding HasSelectedElement}">
                            <TextBlock Text="Core Properties" Foreground="#FF00863D" FontWeight="SemiBold" Margin="0,0,0,10" FontStyle="Italic"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Id" Margin="0,0,0,4"/>
                                    <TextBox IsReadOnly="True" Text="{Binding SelectedElement.Id}" Background="#0A1018" Foreground="#888"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Parent Id" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedElement.ParentId, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Foreground="{StaticResource TextSecondary}" Text="Type" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ElementTypes}" SelectedItem="{Binding SelectedElement.Type, Mode=TwoWay}" Margin="0,0,0,10" UseLayoutRounding="True"/>

                            <TextBlock Foreground="{StaticResource TextSecondary}" Text="Anchor Preset" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AnchorPresets}" SelectedItem="{Binding SelectedElement.AnchorPreset, Mode=TwoWay}" Margin="0,0,0,10" UseLayoutRounding="True"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Position X (supports %)" ToolTip="Use values like 24, 50%, or -10%" />
                                    <TextBox Text="{Binding SelectedElement.XInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Position Y (supports %)" ToolTip="Use values like 16, 50%, or -10%" />
                                    <TextBox Text="{Binding SelectedElement.YInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Z"/>
                                    <TextBox Text="{Binding SelectedElement.ZIndex, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Width (supports %)" ToolTip="Use values like 240, 50%, or -10%" />
                                    <TextBox Text="{Binding SelectedElement.WidthInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Height (supports %)" ToolTip="Use values like 40, 100%, or -10%" />
                                    <TextBox Text="{Binding SelectedElement.HeightInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Transform" Foreground="#FF00863D" FontWeight="SemiBold" Margin="0,5,0,10" FontStyle="Italic"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Offset X (supports %)" ToolTip="Use values like 12, 10%, or -10%" />
                                    <TextBox Text="{Binding SelectedElement.TranslateXInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Offset Y (supports %)" ToolTip="Use values like 8, 10%, or -10%" />
                                    <TextBox Text="{Binding SelectedElement.TranslateYInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Anchor Min X %" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.AnchorMinXPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Anchor Min Y %" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.AnchorMinYPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Anchor Max X %" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.AnchorMaxXPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Anchor Max Y %" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.AnchorMaxYPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Scale X %" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.ScaleXPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Scale Y %" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.ScaleYPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Opacity %" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.OpacityPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Pivot X %" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.PivotXPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Pivot Y %" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.PivotYPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Rotation Deg" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.RotationDegrees, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Grid Columns" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.GridColumns, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Grid Spacing X" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.GridSpacingX, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Grid Spacing Y" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.GridSpacingY, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Foreground="{StaticResource TextSecondary}" Text="Text" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedElement.Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                            <TextBlock Foreground="{StaticResource TextSecondary}" Text="Asset Path / Alias" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedElement.AssetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Value / Root Min Aspect %" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Min / Root Min Width" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.MinValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Max / Root Min Height" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.MaxValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="BG Color [Hex]" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.BackgroundColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="FG Color [Hex]" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.ForegroundColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Border [Hex]" FontSize="11"/>
                                    <TextBox Text="{Binding SelectedElement.BorderColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,0,0,15">
                                <CheckBox IsChecked="{Binding SelectedElement.IsVisible}" Content="Visible" Width="100" Background="#FF0E1825" BorderBrush="#FF24374A" Foreground="#FF9DB4C8"/>
                                <CheckBox IsChecked="{Binding SelectedElement.IsDraggableRegion}" Content="Draggable Region" Width="130" Background="#FF0E1825" BorderBrush="#FF24374A" Foreground="#FF9DB4C8"/>
                                <CheckBox IsChecked="{Binding SelectedElement.IsInteractive}" Content="Interactive" Width="100" Background="#FF0E1825" BorderBrush="#FF24374A" Foreground="#FF9DB4C8"/>
                                <CheckBox IsChecked="{Binding SelectedElement.ClipsChildren}" Content="Clip Children" Width="100" BorderBrush="#FF24374A" Background="#FF0E1825" Foreground="#FF9DB4C8"/>
                                <CheckBox IsChecked="{Binding SelectedElement.HasWindowFrame}" Content="Window Frame" Width="130" Background="#FF0E1825" BorderBrush="#FF24374A" Foreground="#FF9DB4C8"/>
                                <CheckBox IsChecked="{Binding SelectedElement.IsAlwaysOnTop}" Content="Always On Top" Width="130" Background="#FF0E1825" BorderBrush="#FF24374A" Foreground="#FF9DB4C8"/>
                            </WrapPanel>
                        </StackPanel>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,10,0,20"/>

                        <StackPanel IsEnabled="{Binding HasSelectedElement}">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Events" Foreground="#FF00863D" FontWeight="SemiBold" FontStyle="Italic" Width="34"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="  +  " Click="AddEvent_Click" Padding="8,4" Margin="0,0,5,0"/>
                                    <Button Content="  -  " Click="RemoveEvent_Click" Padding="8,4" Foreground="{StaticResource DangerBrush}"/>
                                </StackPanel>
                            </DockPanel>

                            <ListBox ItemsSource="{Binding SelectedElement.Events}" 
                                     SelectedItem="{Binding SelectedEvent, Mode=TwoWay}" 
                                     DisplayMemberPath="DisplayName" 
                                     MinHeight="80" MaxHeight="120"/>

                            <StackPanel IsEnabled="{Binding HasSelectedEvent}">
                                <TextBlock Foreground="{StaticResource TextSecondary}" Text="Event Type" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding EventTypes}" SelectedItem="{Binding SelectedEvent.EventType, Mode=TwoWay}" Margin="0,0,0,20" Foreground="Black"/>

                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="Bindings" Foreground="#FF00863D" FontWeight="SemiBold" VerticalAlignment="Center" FontStyle="Italic"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="  +  " Click="AddBinding_Click" Padding="8,4" Margin="0,0,5,0"/>
                                        <Button Content="  -  " Click="RemoveBinding_Click" Padding="8,4" Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </DockPanel>

                                <ListBox ItemsSource="{Binding SelectedEvent.Bindings}" 
                                         SelectedItem="{Binding SelectedBinding, Mode=TwoWay}" 
                                         DisplayMemberPath="DisplayName" 
                                         MinHeight="80" MaxHeight="120" Margin="0,0,0,10"/>

                                <StackPanel IsEnabled="{Binding HasSelectedBinding}">
                                    <TextBlock Foreground="{StaticResource TextSecondary}" Text="Action" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ActionTypes}" SelectedItem="{Binding SelectedBinding.ActionType, Mode=TwoWay}" Margin="0,0,0,10" Foreground="Black"/>

                                    <Grid Margin="0,0,0,10" Visibility="{Binding SelectedBinding.UsesTargetElementId, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Foreground="{StaticResource TextSecondary}" Text="{Binding SelectedBinding.TargetElementIdLabel}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SelectedBinding.TargetElementId, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,10" Visibility="{Binding SelectedBinding.UsesPropertyType, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="{Binding SelectedBinding.PropertyTypeLabel}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding PropertyTypes}" SelectedItem="{Binding SelectedBinding.PropertyType, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,10" Visibility="{Binding SelectedBinding.UsesIntValue, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="{Binding SelectedBinding.IntValueLabel}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedBinding.IntValue, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,10" Visibility="{Binding SelectedBinding.UsesBoolValue, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="Visible" Margin="0,0,0,4"/>
                                        <CheckBox IsChecked="{Binding SelectedBinding.BoolValue, Mode=TwoWay}" Content="Element Visible"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,10" Visibility="{Binding SelectedBinding.UsesColorValue, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="{Binding SelectedBinding.ColorValueLabel}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedBinding.ColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,10" Visibility="{Binding SelectedBindingUsesSystemStateKeySelection, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="System State Key" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding SystemStateKeys}"
                                                  SelectedItem="{Binding SelectedBinding.StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,10" Visibility="{Binding SelectedBinding.UsesPlainStringValue, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="{StaticResource TextSecondary}" Text="{Binding SelectedBinding.StringValueLabel}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedBinding.StringValue, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="38"
                                                 AcceptsReturn="{Binding SelectedBinding.StringValueMultiline}"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,15,0,0" Padding="15,10" Background="#101926" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Fill="#4CAF50" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="12">
                    <Run Text="Output Directory: " FontWeight="Bold"/>
                    <Run Text="Run\VirtualDrive\"/><Run Text="{Binding Document.PackageAlias}"/>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
